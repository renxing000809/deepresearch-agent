# Search service
SEARCH_API=tavily
TAVILY_API_KEY=your-tavily-api-key
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5

# OpenAI-compatible LLM service
LLM_PROVIDER=custom
LLM_MODEL_ID=从模型广场复制的模型名
LLM_API_KEY=your-tokeness-api-key
LLM_BASE_URL=your-base-url
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# Research workflow
MAX_RESEARCH_TASKS=4
SEARCH_TOPIC_DEPTH=advanced

# Server and CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Optional file log path. Leave empty to log to the console only.
LOG_FILE=
RELOAD=false

# Optional local model settings
LOCAL_LLM=your-local-model
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434
